{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alot1z/export-conversation-skill/schemas/conversation.schema.json",
  "title": "Conversation transcript",
  "description": "Harness-neutral transcript used to compute coverage before writing an export.",
  "type": "object",
  "required": ["session_id", "messages"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "harness": { "type": "string" },
    "started_at": { "type": "string" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant", "tool", "system"] },
          "content": { "type": "string" },
          "timestamp": { "type": "string" },
          "tool": { "type": "string" },
          "outcome": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
